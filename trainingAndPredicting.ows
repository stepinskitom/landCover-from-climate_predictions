		<properties node_id="20" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\xc5\x00\x00\x00\xd1\x00\x00\x04\xe6\x00\x00\x03G\x00\x00\x01\xc6\x00\x00\x00\xef\x00\x00\x04\xe5\x00\x00\x03F\x00\x00\x00\x00\x00\x00\x00\x00\x06\xab\x00\x00\x01\xc6\x00\x00\x00\xef\x00\x00\x04\xe5\x00\x00\x03F', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nimport Orange\nfrom Orange.data import Domain, Table\ninput_list = in_data.copy()\n# Check if the list length is a perfect square\nn = int(len(input_list) ** 0.5)\nif n * n != len(input_list):\n    raise ValueError("The list length must be a perfect square to form a square matrix.")\n\n# Convert list to square matrix\nsquare_matrix = np.array(input_list).reshape(n, n)\n\n# Convert the square matrix to an Orange Table\ntable = Orange.data.Table(square_matrix)\n\n# Output the table for visualization or further processing\nout_data = table', 'filename': None}], 'scriptText': 'import numpy as np\nimport Orange\nfrom Orange.data import Domain, Table\ninput_list = in_data.copy()\n# Check if the list length is a perfect square\nn = int(len(input_list) ** 0.5)\nif n * n != len(input_list):\n    raise ValueError("The list length must be a perfect square to form a square matrix.")\n\n# Convert list to square matrix\nsquare_matrix = np.array(input_list).reshape(n, n)\n\n# Convert the square matrix to an Orange Table\ntable = Orange.data.Table(square_matrix)\n\n# Output the table for visualization or further processing\nout_data = table', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', '__version__': 2}</properties>
